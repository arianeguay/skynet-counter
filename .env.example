# Host running the site: an ssh alias or user@host. Required by `make deploy`.
DEPLOY_HOST=
# Checkout to deploy into, relative to the ssh home directory.
DEPLOY_PATH=skynet-counter

# Read by docker compose on whichever machine runs it.
WEB_PORT=3000

# How often each domain sweeps, as whitespace-separated `slug:seconds`. Left
# unset, compose falls back to `cybersecurite:3600` — what this ran when one
# domain was all there was.
#
# Each sweep pays for its own scoring stage, so the period follows how much a
# domain's feeds actually publish rather than being uniform. The intended shape
# once the remaining domains land, worth re-reading against real volume before
# trusting it:
#
#   SKYNET_SCHEDULE=cybersecurite:3600 domotique:3600 ecologie:10800 design:21600
SKYNET_SCHEDULE=
